# HTTPS en entorno de instancia única de Elastic Beanstalk
# 1) Abre el puerto 443 en el grupo de seguridad de la instancia.
# 2) Da permiso de ejecución a los hooks (los zips hechos en Windows lo pierden).
Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt" : ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      ToPort: 443
      FromPort: 443
      CidrIp: 0.0.0.0/0

container_commands:
  01_permisos_hooks:
    command: "chmod +x .platform/hooks/postdeploy/*.sh .platform/confighooks/postdeploy/*.sh"
    ignoreErrors: true
